# Tabs Studio
*.tss

# Telerik's JustMock configuration file
*.jmconfig

# BizTalk build output
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# OpenCover UI analysis results
OpenCover/
junit/


# Data folders
data/
data/*

# Logs
logs/


# kedro viz
.viz
.telemetry

# Local Git rewrite backups
backup-working-tree.patch
backup-git-log.txt
backup-tags.txt



